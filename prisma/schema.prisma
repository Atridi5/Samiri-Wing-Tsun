generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Flexible translatable text blocks for page sections (hero, about, why, cta, footer, ...)
model SiteText {
  id       String  @id @default(cuid())
  section  String
  locale   String
  title    String?
  subtitle String?
  body     String?

  @@unique([section, locale])
}

model Program {
  id           String                @id @default(cuid())
  slug         String                @unique
  icon         String                @default("shield")
  order        Int                   @default(0)
  translations ProgramTranslation[]
}

model ProgramTranslation {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String

  @@unique([programId, locale])
}

model Benefit {
  id           String                @id @default(cuid())
  category     String
  icon         String                @default("check")
  order        Int                   @default(0)
  translations BenefitTranslation[]
}

model BenefitTranslation {
  id        String  @id @default(cuid())
  benefitId String
  benefit   Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  locale    String
  text      String

  @@unique([benefitId, locale])
}

model Testimonial {
  id           String                    @id @default(cuid())
  name         String
  rating       Int                       @default(5)
  order        Int                       @default(0)
  translations TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String      @id @default(cuid())
  testimonialId String
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  locale        String
  text          String

  @@unique([testimonialId, locale])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String   @default("general")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model PricingPlan {
  id           String                   @id @default(cuid())
  order        Int                      @default(0)
  translations PricingPlanTranslation[]
}

model PricingPlanTranslation {
  id       String      @id @default(cuid())
  planId   String
  plan     PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  locale   String
  name     String
  price    String
  period   String
  features String

  @@unique([planId, locale])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Registration {
  id                   String   @id @default(cuid())
  name                 String
  phone                String
  email                String?
  age                  Int?
  address              String?
  program              String
  experience           String?
  heardFrom            String?
  preferredSchedule    String?
  emergencyContactName String?
  emergencyContactPhone String?
  healthNotes          String?
  message              String?
  status               String   @default("new")
  adminReply           String?
  createdAt            DateTime @default(now())
}

model ContactInfo {
  id          String  @id @default(cuid())
  address     String
  city        String
  phone       String
  email       String?
  instagram   String?
  facebook    String?
  tiktok      String?
  mapEmbedUrl String?
}

model FaqItem {
  id           String            @id @default(cuid())
  order        Int               @default(0)
  translations FaqTranslation[]
}

model FaqTranslation {
  id        String  @id @default(cuid())
  faqId     String
  faq       FaqItem @relation(fields: [faqId], references: [id], onDelete: Cascade)
  locale    String
  question  String
  answer    String

  @@unique([faqId, locale])
}
